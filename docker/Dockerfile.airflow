FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Airflow con constraints oficiales para Python 3.11
ARG AIRFLOW_VERSION=2.9.0
RUN pip install --no-cache-dir \
    apache-airflow==${AIRFLOW_VERSION} \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-3.11.txt"

# Dependencias del proyecto que usa el DAG
RUN pip install --no-cache-dir \
    networkx==3.3 \
    pandas==2.2.2 \
    numpy==1.26.4 \
    requests \
    python-dotenv==1.0.1

# Código fuente que el DAG importa
COPY core/       ./core/
COPY graph/      ./graph/
COPY ingest/     ./ingest/
COPY safety/     ./safety/
COPY dags/       ./dags/

# Variables de entorno base de Airflow
ENV AIRFLOW_HOME=/app/airflow
ENV AIRFLOW__CORE__DAGS_FOLDER=/app/dags
ENV AIRFLOW__CORE__LOAD_EXAMPLES=False
ENV AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8082
ENV AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////app/airflow/airflow.db
ENV AIRFLOW__CORE__EXECUTOR=SequentialExecutor

RUN mkdir -p /app/airflow /app/graph

# Script de inicio: inicializa DB y arranca en modo standalone
COPY docker/airflow_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8082

ENTRYPOINT ["/entrypoint.sh"]